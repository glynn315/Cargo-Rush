APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cargoapi
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The two clients.
# CargoUI is a first-party SPA on its own origin, so its host has to be
# stateful for the Sanctum session cookie to reach the API, and it has to be
# an allowed CORS origin. cargoApp sends a bearer token and needs neither.
FRONTEND_URL=http://localhost:4200
SANCTUM_STATEFUL_DOMAINS=localhost:4200,127.0.0.1:4200

# Where `expo start --web` serves cargoApp. Used only to allow that origin in
# config/cors.php; a handset build is not subject to CORS and ignores it.
EXPO_WEB_URL=http://localhost:8081

# Every row in this system belongs to a company, and companies are created by
# registering them at POST /api/v1/register. The tenancy migration also lays
# down one company for the rows an existing install already has, and for the
# seeded starting accounts to belong to. This is what it is called.
#
# Worth setting before the first migration on an install that is somebody's
# actual business â€” otherwise their books sit in a company called "Cargo Rush"
# because that is what the software is called. The code is the slug it is
# filed under; leave it unset to derive one from the name.
DEFAULT_COMPANY_NAME="Cargo Rush"
# DEFAULT_COMPANY_CODE=
# DEFAULT_COMPANY_EMAIL=

# Which company the demo seeders fill with the worked example â€” by id, code or
# name. Unset means the oldest company on the install, which on a single
# company install is the only one. Never point this at a real customer's
# company: it adds trucks they have never owned.
# DEMO_COMPANY=

# The password the seeded starting accounts are created with. They go into the
# first company only, never into one that registers.
# Set it per install; change the passwords in-app before going live.
SEED_PASSWORD=password

# The password a customer login is created with when the office adds the firm
# in Customer Management. The create response prints it once so the desk can
# pass it on; the customer changes it after signing in.
CUSTOMER_DEFAULT_PASSWORD=cargorush123

# The tariff. What a haul is charged, in centavos:
#   price = base + (per_km * km) + (per_kg * kg), floored at the minimum.
# These are the business's numbers, not the developer's â€” correct them here
# rather than in code. `config/cargo.php` is the only thing that reads them.
TARIFF_BASE_CENTS=150000
TARIFF_PER_KM_CENTS=3500
TARIFF_PER_KG_CENTS=200
TARIFF_MINIMUM_CENTS=150000

# The tariff above is the fallback. Where a pricing zone claims a booking's
# destination, its own distance brackets price the run instead â€” those are rows
# the office edits in the Rate Card module, not settings.

# Diesel. A rate card is drawn at some assumed pump price; when the pump moves,
# the card is stale by roughly the fuel share of a run. Rather than retype every
# bracket, the difference is derived:
#   adjustment = clamp((today - baseline) / baseline * sensitivity, Â±cap)
# Baseline is what the cards were drawn at. Sensitivity is the fuel share of a
# run â€” at 0.35 a 10% pump rise moves a quote 3.5%, because salary and tyres did
# not get more expensive. The cap is the guard rail, in basis points: whatever
# the pump does, a quote does not move further than this without somebody
# deciding to redraw the cards.
DIESEL_BASELINE_CENTS=6500
DIESEL_SENSITIVITY=0.35
DIESEL_CAP_BP=2500

# How long a delivered run's invoice has before it falls overdue.
BILLING_TERMS_DAYS=30

# Tax, in basis points — 1200 is 12%. The PH defaults: 12% VAT on sales, and 2%
# expanded withholding tax on payments for hauling, taken from the GROSS (VAT
# included) because that is how the BIR computes it.
#
# These are the statutory defaults. A company that is not VAT-registered turns
# VAT off for itself, and whether a customer withholds is set per customer —
# both override what is here. Each invoice freezes the rates that applied on
# the day it was issued, so changing these never rewrites a document already
# sent.
TAX_VAT_RATE_BP=1200
TAX_WITHHOLDING_RATE_BP=200

# Are the tariff and rate card quoted VAT-inclusive? False means a quote is the
# net haul and VAT is added on top, which is how a rate card is normally
# written. True means the desk quotes an all-in figure and the VAT inside it is
# worked backwards, so the customer is billed exactly what they were told.
TAX_PRICES_INCLUDE_VAT=false

# Proof-of-delivery photographs. The `public` disk needs `php artisan
# storage:link` once per install, or the stored URL resolves to nothing.
POD_DISK=public
POD_DIRECTORY=pod
POD_MAX_KB=8192

# Staff photographs and applicant CVs. Its own disk rather than sharing the one
# above, because these are personnel files â€” an install that later moves them to
# private storage should not have to move every delivery photograph with them.
HR_DISK=public
HR_DIRECTORY=people
HR_PHOTO_MAX_KB=4096
HR_RESUME_MAX_KB=8192

# The password a staff login is created with from the roster. Shown once in the
# create response so whoever added them can pass it on; they change it after
# signing in. The same trade as CUSTOMER_DEFAULT_PASSWORD, for the same reason.
STAFF_DEFAULT_PASSWORD=cargorush123


BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
